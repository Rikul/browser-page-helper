{
  "manifest_version": 3,
  "name": "Browser Page Helper",
  "version": "0.1.0",
  "description": "Chat with an AI assistant about the current page, using any OpenAI-compatible API.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open page helper"
  }
}
